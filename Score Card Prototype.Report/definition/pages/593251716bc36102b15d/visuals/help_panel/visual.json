  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this scorecard",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "24pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Filters",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "17pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Business Unit, Division, District, and Period filter the scorecard. With no single period selected, results default to Period 9 of fiscal year 2026. Opening or closing help keeps your selections.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#444444"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "KPI cards",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "17pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The large value is the latest calendar week in the selected period. The gray label is its goal. The comparison line shows the fiscal week, actual value, and relative percent change from the preceding week, which may be in the prior period.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#444444"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Performance colors",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "17pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Green is on or above target; yellow, orange, and red indicate progressively weaker performance against metric-specific thresholds. Gray means neutral or unavailable. Comparison text is green for favorable movement and red for unfavorable movement; some metrics improve when their values decrease.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#444444"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Year to date (YTD)",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "17pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "YTD runs from the beginning of the fiscal year through the latest selected week. Rates and scores use averages, not totals; integer-formatted counts are summed. District averages are unweighted because the source has no weighting fields.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#444444"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Weekly results and goals",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "17pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Week 1 through Week 4 are positions within the selected fiscal period, not fixed fiscal-week numbers. Goal is the metric target. A blank cell means no applicable value; it does not mean zero.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#444444"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Metric groups",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "17pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Use the blue + and - controls beside group labels to expand or collapse detail. Group totals are intentionally blank because the metrics use different units and cannot be meaningfully added.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#444444"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Reporting dates",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "17pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data as of reflects the latest available source load timestamp. The reporting range uses the selected period's actual week-start and week-end dates, which can cross calendar-month boundaries.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "color": "#444444"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
