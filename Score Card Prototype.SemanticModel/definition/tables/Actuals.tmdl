	measure 'KPI Week Text' =
			VAR CurrentResult = [Current Week Actual]
			RETURN
				IF ( NOT ISBLANK ( CurrentResult ), "WK " & FORMAT ( [Latest Week Number], "0" ) & ": " & [Current Week Display] )
		displayFolder: KPI

	measure 'KPI Change Text' =
			VAR ChangePercent = [Week-over-Week Percent Change]
			VAR ChangeAmount = [Week-over-Week Change]
			VAR ChangeSign = SWITCH ( TRUE (), ChangeAmount > 0, "+", ChangeAmount < 0, "-", "" )
			RETURN
				IF (
					NOT ISBLANK ( [Current Week Actual] ) && NOT ISBLANK ( [Previous Week Actual] ) && NOT ISBLANK ( ChangePercent ),
					[Week-over-Week Direction] & " " & ChangeSign & FORMAT ( ABS ( ChangePercent ), "0.0%" ) & " vs last wk"
				)
		displayFolder: KPI

	measure 'Result Performance Color' =
			VAR MetricActual = [Actual Value]
			VAR TargetValue = [Goal Value]
			VAR HigherBetter = SELECTEDVALUE ( Metrics[HigherIsBetter] ) = "Yes"
			VAR ResultRatio = IF ( HigherBetter, DIVIDE ( MetricActual, TargetValue ), DIVIDE ( TargetValue, MetricActual ) )
			VAR GreenLevel = COALESCE ( MAX ( Goals[GreenThreshold] ), 1 )
			VAR RawYellow = MAX ( Goals[YellowThreshold] )
			VAR RawOrange = MAX ( Goals[OrangeThreshold] )
			VAR YellowLevel = COALESCE ( IF ( NOT HigherBetter && RawYellow > GreenLevel, DIVIDE ( 1, RawYellow ), RawYellow ), 0.95 )
			VAR OrangeLevel = COALESCE ( IF ( NOT HigherBetter && RawOrange > GreenLevel, DIVIDE ( 1, RawOrange ), RawOrange ), 0.9 )
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( MetricActual ) || ISBLANK ( TargetValue ), "#666666",
					NOT HigherBetter && MetricActual = 0 && TargetValue > 0, "#2E7D32",
					ISBLANK ( ResultRatio ), "#666666",
					ResultRatio >= GreenLevel, "#2E7D32",
					ResultRatio >= YellowLevel, "#F9B900",
					ResultRatio >= OrangeLevel, "#D95F02",
					"#C62828"
				)
		displayFolder: Formatting

	measure 'YTD Performance Color' =
			VAR MetricActual = [YTD Actual]
			VAR TargetValue = [Goal Value]
			VAR HigherBetter = SELECTEDVALUE ( Metrics[HigherIsBetter] ) = "Yes"
			VAR ResultRatio = IF ( HigherBetter, DIVIDE ( MetricActual, TargetValue ), DIVIDE ( TargetValue, MetricActual ) )
			VAR GreenLevel = COALESCE ( MAX ( Goals[GreenThreshold] ), 1 )
			VAR RawYellow = MAX ( Goals[YellowThreshold] )
			VAR RawOrange = MAX ( Goals[OrangeThreshold] )
			VAR YellowLevel = COALESCE ( IF ( NOT HigherBetter && RawYellow > GreenLevel, DIVIDE ( 1, RawYellow ), RawYellow ), 0.95 )
			VAR OrangeLevel = COALESCE ( IF ( NOT HigherBetter && RawOrange > GreenLevel, DIVIDE ( 1, RawOrange ), RawOrange ), 0.9 )
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( MetricActual ) || ISBLANK ( TargetValue ), "#666666",
					NOT HigherBetter && MetricActual = 0 && TargetValue > 0, "#2E7D32",
					ISBLANK ( ResultRatio ), "#666666",
					ResultRatio >= GreenLevel, "#2E7D32",
					ResultRatio >= YellowLevel, "#F9B900",
					ResultRatio >= OrangeLevel, "#D95F02",
					"#C62828"
				)
		displayFolder: Formatting

	measure 'Period Week 1 Color' =
			VAR SelectedYear = [Selected Fiscal Year]
			VAR SelectedPeriod = [Selected Fiscal Period]
			RETURN CALCULATE ( [Result Performance Color], KEEPFILTERS ( Calendar[FiscalYear] = SelectedYear ), KEEPFILTERS ( Calendar[FiscalPeriod] = SelectedPeriod ), Calendar[PeriodWeek] = 1 )
		displayFolder: Formatting

