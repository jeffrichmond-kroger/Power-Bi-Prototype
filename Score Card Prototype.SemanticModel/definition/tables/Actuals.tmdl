	measure 'Matrix Row Background' =
			IF (
				ISINSCOPE ( Metrics[MetricName] ),
				IF ( MOD ( SELECTEDVALUE ( Metrics[MetricSort], 1 ), 2 ) = 0, "#F7F7F7", "#FFFFFF" ),
				IF ( ISINSCOPE ( Metrics[MetricGroup] ), "#E7E7E7", "#FFFFFF" )
			)
		displayFolder: Formatting

