	partition Actuals = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\JR87208\OneDrive - The Kroger Co\Documents\Reportal\PowerBI_Scorecard_Prototype_Data.xlsx"), null, true),
				    Actuals_Sheet = Source{[Item="Actuals",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Actuals_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"DistrictKey", Int64.Type}, {"MetricKey", Int64.Type}, {"WeekKey", Int64.Type}, {"ActualValue", type number}, {"LoadDateTime", type text}})
				in
